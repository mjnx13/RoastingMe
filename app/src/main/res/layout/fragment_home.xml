<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RoastingMe"
            android:textColor="#7C3AED"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="작은 정리부터 시작해 볼까요?"
            android:textSize="16sp" />

        <!-- 청소 시작 안내 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#EDE9FE">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="지금 내 공간은?"
                android:textColor="#3B0764"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="생활환경을 촬영하면 AI가 정리가 필요한 부분과 지금 할 수 있는 행동을 알려줘요."
                android:textColor="#4B5563"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="하단의 촬영 버튼을 눌러 시작하세요."
                android:textColor="#7C3AED"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 일정 영역 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="오늘의 청소 일정"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_home_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="청소 일정이 표시될 공간이에요."
            android:textSize="15sp" />

        <!-- 기록 영역 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="최근 청소 기록"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_home_recent_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="최근 청소 결과가 표시될 공간이에요."
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>